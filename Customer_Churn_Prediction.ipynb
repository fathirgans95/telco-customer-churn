import streamlit as st
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, confusion_matrix, roc_auc_score

KURS_IDR = 16000  # 1 USD = Rp16.000

st.set_page_config(
    page_title="Prediksi Pelanggan Berhenti (Telco Churn)",
    page_icon="📊",
    layout="wide",
)


@st.cache_resource
def load_assets():
    url = "https://raw.githubusercontent.com/fathirgans95/telco-customer-churn/main/WA_Fn-UseC_-Telco-Customer-Churn.csv"
    df = pd.read_csv(url)
    df["TotalCharges"] = pd.to_numeric(df["TotalCharges"], errors="coerce")
    df = df.dropna(subset=["TotalCharges"]).copy()
    if "customerID" in df.columns:
        df = df.drop(columns=["customerID"])

    y = df["Churn"].map({"No": 0, "Yes": 1})
    X_encoded = pd.get_dummies(df.drop(columns=["Churn"]), drop_first=True)

    X_train, X_test, y_train, y_test = train_test_split(
        X_encoded, y, test_size=0.2, random_state=42, stratify=y
    )

    num_cols = ["tenure", "MonthlyCharges", "TotalCharges"]
    scaler = StandardScaler()
    X_train[num_cols] = scaler.fit_transform(X_train[num_cols])
    X_test[num_cols] = scaler.transform(X_test[num_cols])

    log_model = LogisticRegression(max_iter=1000, random_state=42)
    log_model.fit(X_train, y_train)

    rf_model = RandomForestClassifier(n_estimators=100, random_state=42)
    rf_model.fit(X_train, y_train)

    return log_model, rf_model, scaler, list(X_train.columns), X_test, y_test


log_model, rf_model, scaler, model_columns, X_test, y_test = load_assets()

st.title("📊 Prediksi Pelanggan Berhenti (Telco Churn)")
st.caption("Aplikasi prediksi churn pelanggan telekomunikasi berbasis Machine Learning (Mata Uang: Rupiah, 1 USD = Rp16.000)")

tab1, tab2 = st.tabs(["Prediksi Pelanggan", "Evaluasi & Grafik Model"])

with tab1:
    st.subheader("Input Data Pelanggan")

    col1, col2, col3 = st.columns(3)

    with col1:
        gender = st.selectbox("Jenis Kelamin", ["Male", "Female"])
        senior = st.selectbox("Senior Citizen", [0, 1], format_func=lambda x: "Yes (1)" if x == 1 else "No (0)")
        partner = st.selectbox("Partner", ["Yes", "No"])
        dependents = st.selectbox("Dependents", ["Yes", "No"])

    with col2:
        contract = st.selectbox("Jenis Kontrak (Contract)", ["Month-to-month", "One year", "Two year"])
        phone_service = st.selectbox("Layanan Telepon (Phone Service)", ["Yes", "No"])
        multiple_lines = st.selectbox("Multiple Lines", ["No", "Yes", "No phone service"])
        internet_service = st.selectbox("Layanan Internet (Internet Service)", ["Fiber optic", "DSL", "No"])

    with col3:
        online_security = st.selectbox("Online Security", ["No", "Yes", "No internet service"])
        tech_support = st.selectbox("Tech Support", ["No", "Yes", "No internet service"])
        payment_method = st.selectbox("Metode Pembayaran", [
            "Electronic check",
            "Mailed check",
            "Bank transfer (automatic)",
            "Credit card (automatic)",
        ])
        model_choice = st.selectbox("Model Prediksi", ["Logistic Regression", "Random Forest"])

    c_tenure, c_monthly, c_total = st.columns(3)
    with c_tenure:
        tenure = st.slider("Tenure / Lama Berlangganan (Bulan)", 1, 72, 12)
    with c_monthly:
        monthly_charges_idr = st.number_input(
            "Tagihan Bulanan (Rp)",
            min_value=0,
            max_value=5000000,
            value=1120000,
            step=50000,
        )
    with c_total:
        total_charges_idr = st.number_input(
            "Total Tagihan (Rp)",
            min_value=0,
            max_value=200000000,
            value=int(tenure * monthly_charges_idr),
            step=100000,
        )

    monthly_fmt = f"Rp {monthly_charges_idr:,.0f}".replace(",", ".")
    total_fmt = f"Rp {total_charges_idr:,.0f}".replace(",", ".")
    st.write(f"Ringkasan Tagihan: **{monthly_fmt} / bulan** | Total: **{total_fmt}**")

    if st.button("Prediksi Churn", use_container_width=True):
        monthly_usd = monthly_charges_idr / KURS_IDR
        total_usd = total_charges_idr / KURS_IDR

        input_dict = {
            "gender": gender,
            "SeniorCitizen": senior,
            "Partner": partner,
            "Dependents": dependents,
            "tenure": tenure,
            "PhoneService": phone_service,
            "MultipleLines": multiple_lines,
            "InternetService": internet_service,
            "OnlineSecurity": online_security,
            "OnlineBackup": "No",
            "DeviceProtection": "No",
            "TechSupport": tech_support,
            "StreamingTV": "No",
            "StreamingMovies": "No",
            "Contract": contract,
            "PaperlessBilling": "Yes",
            "PaymentMethod": payment_method,
            "MonthlyCharges": monthly_usd,
            "TotalCharges": total_usd,
        }

        input_df = pd.DataFrame([input_dict])
        input_encoded = pd.get_dummies(input_df).reindex(columns=model_columns, fill_value=0)
        num_cols = ["tenure", "MonthlyCharges", "TotalCharges"]
        input_encoded[num_cols] = scaler.transform(input_encoded[num_cols])

        active_model = log_model if model_choice == "Logistic Regression" else rf_model
        pred = active_model.predict(input_encoded)[0]
        proba = active_model.predict_proba(input_encoded)[0]
        prob_stay, prob_churn = proba[0] * 100, proba[1] * 100

        st.divider()
        st.subheader(f"Hasil Prediksi ({model_choice})")

        if pred == 1:
            st.error(f"Pelanggan berpotensi **CHURN (Berhenti)** dengan probabilitas **{prob_churn:.1f}%**.")
        else:
            st.success(f"Pelanggan cenderung **BERTAHAN (Tidak Churn)** dengan probabilitas bertahan **{prob_stay:.1f}%** (probabilitas churn: **{prob_churn:.1f}%**).")

        m1, m2 = st.columns(2)
        m1.metric("Probabilitas Bertahan (No)", f"{prob_stay:.1f}%")
        m2.metric("Probabilitas Churn (Yes)", f"{prob_churn:.1f}%")

        fig, ax = plt.subplots(figsize=(6, 2.8))
        bars = ax.barh(["Bertahan (No)", "Churn (Yes)"], [prob_stay, prob_churn], color=["#22c55e", "#ef4444"])
        ax.set_xlim(0, 110)
        ax.set_xlabel("Probabilitas (%)")
        ax.set_title("Probabilitas Prediksi Pelanggan")
        for bar, val in zip(bars, [prob_stay, prob_churn]):
            ax.text(val + 1.5, bar.get_y() + bar.get_height() / 2, f"{val:.1f}%", va="center", fontweight="bold")
        plt.tight_layout()
        st.pyplot(fig)

with tab2:
    st.subheader("Evaluasi & Grafik Model")

    y_pred_log = log_model.predict(X_test)
    y_prob_log = log_model.predict_proba(X_test)[:, 1]
    y_pred_rf = rf_model.predict(X_test)
    y_prob_rf = rf_model.predict_proba(X_test)[:, 1]

    c1, c2, c3, c4 = st.columns(4)
    c1.metric("Akurasi Logistic Regression", f"{accuracy_score(y_test, y_pred_log)*100:.2f}%")
    c2.metric("ROC-AUC Logistic Regression", f"{roc_auc_score(y_test, y_prob_log):.4f}")
    c3.metric("Akurasi Random Forest", f"{accuracy_score(y_test, y_pred_rf)*100:.2f}%")
    c4.metric("ROC-AUC Random Forest", f"{roc_auc_score(y_test, y_prob_rf):.4f}")

    fig_eval, axes = plt.subplots(1, 2, figsize=(12, 4.2))
    cm = confusion_matrix(y_test, y_pred_log)
    sns.heatmap(
        cm,
        annot=True,
        fmt="d",
        cmap="Blues",
        ax=axes[0],
        xticklabels=["No (0)", "Yes (1)"],
        yticklabels=["No (0)", "Yes (1)"],
    )
    axes[0].set_title("Confusion Matrix - Logistic Regression")

    feat_imp = (
        pd.Series(rf_model.feature_importances_, index=model_columns)
        .sort_values(ascending=False)
        .head(10)
    )
    sns.barplot(x=feat_imp.values, y=feat_imp.index, ax=axes[1])
    axes[1].set_title("Top 10 Fitur Terpenting - Random Forest")

    plt.tight_layout()
    st.pyplot(fig_eval)
